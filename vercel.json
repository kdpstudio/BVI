{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/weekly-reports",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/tax-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recurring-invoices",
      "schedule": "0 7 * * *"
    }
  ]
}
